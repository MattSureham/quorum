{
  "name": "quorum",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Multi-agent group chat: humans and heterogeneous coding agents (Claude Code, Codex, ...) collaborate in one shared room on one project, with live floor control.",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.12.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:shared": "tsx scripts/shared-session-smoke.ts",
    "smoke:sidecar": "tsx scripts/sidecar-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "web:dev": "pnpm --filter @quorum/client-web dev",
    "web:build": "pnpm --filter @quorum/client-web build",
    "web:preview": "pnpm --filter @quorum/client-web preview",
    "desktop:dev": "pnpm --filter @quorum/desktop tauri dev",
    "desktop:build": "pnpm --filter @quorum/desktop tauri build",
    "desktop:check": "bash -lc 'source .tools/packaging-env.sh && pnpm --filter @quorum/desktop tauri info && cd apps/desktop/src-tauri && cargo check'",
    "packaging:env": "bash scripts/setup-packaging-env.sh",
    "sidecar:bun:build": "bash -lc 'source .tools/packaging-env.sh && tsx scripts/build-sidecar-bun.ts'",
    "sidecar:bun:smoke": "bash -lc 'source .tools/packaging-env.sh && tsx scripts/bun-sidecar-smoke.ts'",
    "sidecar:node:build": "tsx scripts/build-sidecar-node.ts",
    "sidecar:node:smoke": "tsx scripts/node-sidecar-smoke.ts"
  },
  "devDependencies": {
    "@quorum/core": "workspace:*",
    "@quorum/daemon": "workspace:*",
    "@quorum/protocol": "workspace:*",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
