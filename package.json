{
  "name": "quorum",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Multi-agent group chat: humans and heterogeneous coding agents (Claude Code, Codex, ...) collaborate in one shared room on one project, with live floor control.",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@9.12.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
