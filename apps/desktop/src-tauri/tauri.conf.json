{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quorum",
  "version": "0.0.1",
  "identifier": "dev.quorum.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @quorum/client-web dev",
    "beforeBuildCommand": "pnpm -w sidecar:bun:build && pnpm --filter @quorum/client-web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../packages/client-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quorum",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../dist-sidecar/bun/quorum-sidecar": "sidecars/quorum-sidecar",
      "../../../dist-sidecar/bun/quorum-sidecar.exe": "sidecars/quorum-sidecar.exe"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
