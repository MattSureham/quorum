{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quorum",
  "version": "0.0.1",
  "identifier": "dev.quorum.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @quorum/client-web dev",
    "beforeBuildCommand": "pnpm -w sidecar:bun:build && pnpm --filter @quorum/client-web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../packages/client-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quorum",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../dist-sidecar/bun/quorum-sidecar": "sidecars/quorum-sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
